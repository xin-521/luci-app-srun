# Every text file in this repo ends up on a Linux router (or is parsed by
# sh/ucode/node), so checkout must never produce CRLF regardless of the
# user's core.autocrlf setting.
* text=auto eol=lf

# Windows-only helpers would break with LF.
*.bat text eol=crlf
*.cmd text eol=crlf

# Never touch binaries.
*.apk      binary
*.tar.gz   binary
*.gz       binary
*.lmo      binary
prebuilt/* binary
