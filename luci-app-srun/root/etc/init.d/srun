#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: Apache-2.0

USE_PROCD=1
START=95
STOP=10

start_service() {
	. /lib/functions.sh
	config_load srun
	config_get_bool enabled main enabled 1
	[ "$enabled" = "1" ] || return 0

	config_get binary main binary /usr/bin/srun
	if [ ! -x "$binary" ]; then
		logger -t srun -p user.err "binary not found or not executable: $binary"
		return 1
	fi

	/usr/libexec/srun-generate-config || logger -t srun -p user.warn "config generation failed"

	procd_open_instance
	procd_set_param command /usr/libexec/srun-daemon
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param file /etc/config/srun
	procd_close_instance
}

reload_service() {
	stop
	start
}

service_triggers() {
	. /lib/functions.sh
	config_load srun
	procd_add_reload_trigger srun

	# Re-authenticate when the WAN interface comes up (configurable).
	local iface
	config_get iface main trigger_iface wan
	procd_add_interface_trigger "interface.*" "$iface" /etc/init.d/srun reload
}
